# Copy as /etc/maintflow/production.env with root ownership and mode 0600.
# For the private rehearsal, use /etc/maintflow/rehearsal.env and staging values.
# Set AUTH_TRUSTED_ORIGIN=http://localhost:18100 for that rehearsal file only.
# Production URL is https://tkofnsyqywhixuotbiet.supabase.co.
# Match the public publishable key used for the build. SUPABASE_SERVICE_ROLE_KEY
# is the server-only variable for the dedicated modern production secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_RATE_LIMIT_SECRET=
AUTH_TRUSTED_ORIGIN=https://ccp-inst.duckdns.org
